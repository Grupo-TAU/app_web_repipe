# Copiar a .env y completar. NUNCA commitear .env.
USE_MOCK=1

# Supabase (clave publicable/anon; jamás la service_role)
SUPABASE_URL=
SUPABASE_KEY=

# Google Drive: ruta al JSON de la cuenta de servicio O su contenido
GOOGLE_SA_JSON_PATH=
GOOGLE_SA_JSON=
DRIVE_PARENT_FOLDER_ID=

# Solo modo mock (por defecto fixtures/fotos)
FOTOS_LOCAL_DIR=

# Opcionales: tamaño de página del PDF
# PAGINA=A4 portrait
# MARGEN=12mm
